# ==============================================================================
# AI Audiobook Generator — environment configuration
#
# Copy to .env for local development: cp .env.example .env
# NEVER commit a real .env file. Values below are safe local-dev defaults
# (matching docker-compose.yml) or empty placeholders — none of them are
# real secrets.
#
# Config is validated at startup (packages/config, python/workers-common) —
# missing/invalid required values make the process fail fast rather than
# silently fall back to something unsafe. See docs/architecture/
# deployment-architecture.md §43 for the app/env/secrets/model separation.
#
# This file covers the TypeScript services (apps/api, apps/worker-cpu). The
# Python workers (worker-ai, worker-gpu) use their own env var names — see
# python/workers-common/src/workers_common/config.py for the authoritative
# list (ENVIRONMENT, SERVICE_NAME, SERVICE_VERSION, WORKER_ID, QUEUE_NAME,
# DATABASE_URL, REDIS_URL, STORAGE_ENDPOINT_URL, STORAGE_BUCKET,
# STORAGE_ACCESS_KEY_ID, STORAGE_SECRET_ACCESS_KEY, MODEL_ID) — docker-compose.yml
# sets these directly for the containerized workers.
# ==============================================================================

# ---- APPLICATION CONFIG (per-service identity) -----------------------------
NODE_ENV=development
SERVICE_NAME=api
LOG_LEVEL=info

# ---- ENVIRONMENT CONFIG (deployment-shaped, not secret) --------------------
PORT=3000
BODY_SIZE_LIMIT_BYTES=512000
CORS_ALLOWED_ORIGINS=http://localhost:3001
WORKER_CONCURRENCY=2
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50

# ---- SECRETS (never commit real values; local dev defaults only) -----------
# Local dev Postgres — matches docker-compose.yml `postgres` service.
DATABASE_URL=postgresql://audiobook:audiobook_dev_password@localhost:5432/audiobook
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Local dev Redis — matches docker-compose.yml `redis` service.
REDIS_URL=redis://localhost:6379

# Local dev MinIO (S3-compatible) — matches docker-compose.yml `minio` service.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=audiobook-dev
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true

# JWT verification boundary (Phase 1: verification only, no issuance flows yet).
# Provide either AUTH_JWT_JWKS_URL or AUTH_JWT_PUBLIC_KEY.
AUTH_JWT_ISSUER=https://auth.local
AUTH_JWT_AUDIENCE=audiobook-api
AUTH_JWT_JWKS_URL=
AUTH_JWT_PUBLIC_KEY=

# Bearer token required to read GET /metrics and GET /health/dependencies.
METRICS_SERVICE_TOKEN=dev-metrics-token-change-me

# ---- MODEL CONFIGURATION (reserved — not used in Phase 1) ------------------
# Director LLM / TTS provider credentials and model references are introduced
# in later phases (Director, TTS). Nothing to configure here yet.

# ---- INGESTION PIPELINE (apps/worker-cpu only; Phase 2) --------------------
# All of these have safe defaults (packages/config/src/schemas.ts
# ingestionEnvSchema / @audio-book/ingestion's DEFAULT_INGESTION_CONFIG) —
# uncomment only to override for a specific environment.
# INGESTION_MAX_FILE_SIZE_BYTES=209715200
# INGESTION_MAX_PAGES=3000
# INGESTION_MAX_EPUB_ENTRY_COUNT=10000
# INGESTION_MAX_EPUB_UNCOMPRESSED_BYTES=524288000
# INGESTION_MAX_EPUB_ENTRY_UNCOMPRESSED_BYTES=104857600
# INGESTION_PARSER_TIMEOUT_MS=120000
# INGESTION_NORMALIZATION_TIMEOUT_MS=60000
# INGESTION_DEHYPHENATE=true
# INGESTION_HEADER_FOOTER_CONFIDENCE_THRESHOLD=0.6
# INGESTION_MAX_IMAGE_DIMENSION_PX=10000
# INGESTION_MAX_IMAGE_PIXELS=100000000
# INGESTION_MAX_IMAGE_PAGES=3000
# INGESTION_OCR_LOW_CONFIDENCE_THRESHOLD=0.6

# ---- OCR ENGINE (apps/worker-cpu only; Phase 2) ----------------------------
# OCR_ENABLED=true uses TesseractOcrProvider; set to false to fall back to
# UnavailableOcrProvider (pages needing OCR are flagged NEEDS_REVIEW, never
# silently emptied). OCR_LANG_PATH points at pre-fetched trained-data files
# so the worker never makes a runtime network call for language data —
# infra/docker/worker-cpu.Dockerfile bakes /repo/ocr-lang-data (eng only) in
# and sets this automatically; override only if you've provisioned your own
# language files elsewhere. Leaving OCR_LANG_PATH unset allows tesseract.js's
# own network fetch, which is fine for local dev but not for an offline/
# sandboxed deployment.
# OCR_ENABLED=true
# OCR_LANGUAGE=eng
# OCR_LANG_PATH=/repo/ocr-lang-data
# OCR_TIMEOUT_MS=60000
# OCR_RASTER_SCALE=2.0

# ==============================================================================
# staging/production notes:
#   - All values above marked SECRETS must come from a secrets manager
#     injected into the runtime environment, never from a checked-in file.
#   - NODE_ENV=staging or NODE_ENV=production; LOG_LEVEL should be `info` or
#     stricter (avoid `debug`/`trace` in shared environments).
#   - CORS_ALLOWED_ORIGINS must be an explicit allowlist, never a wildcard.
#   - Rotate METRICS_SERVICE_TOKEN and AUTH_JWT_* material on a documented
#     schedule (deployment-architecture.md §43).
# ==============================================================================
