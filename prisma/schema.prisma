  version                 Int
  supersedesAudiobookId   String?   @map("supersedes_audiobook_id") @db.Uuid
  supersededByAudiobookId String?   @map("superseded_by_audiobook_id") @db.Uuid
  isCurrent               Boolean   @default(false) @map("is_current")
  supersededAt            DateTime? @map("superseded_at") @db.Timestamptz(6)
  isPreviewBuild          Boolean   @default(false) @map("is_preview_build")

  status AudiobookStatus

  containerFormat String @map("container_format")
  durationMs      Int    @map("duration_ms")
