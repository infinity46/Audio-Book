/// §14.2. Platform data, not tenant-scoped.
model ModelRegistry {
  id          String              @id @db.Uuid
  role        ModelRole
  providerId  String              @map("provider_id")
  modelId     String              @map("model_id")
  displayName String              @map("display_name")
  licenceNote String?             @map("licence_note")
  status      ModelRegistryStatus
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  versions ModelVersion[]

  @@unique([role, providerId, modelId])
  @@map("model_registry")
}

/// §14.3. Fully immutable except `deprecated_at`, `quarantined_at`,
/// `quarantine_reason`. Never deleted — `ON DELETE RESTRICT` from everything.
model ModelVersion {
  id                 String    @id @db.Uuid
  modelRegistryId    String    @map("model_registry_id") @db.Uuid
  version            String
  paramsFingerprint  String    @map("params_fingerprint") @db.Char(64)
  config             Json?     @db.JsonB
  weightsStorageKey  String?   @map("weights_storage_key")
  weightsContentHash String?   @map("weights_content_hash") @db.Char(64)
  releasedAt         DateTime  @map("released_at") @db.Timestamptz(6)
  deprecatedAt       DateTime? @map("deprecated_at") @db.Timestamptz(6)
  quarantinedAt      DateTime? @map("quarantined_at") @db.Timestamptz(6)
  quarantineReason   String?   @map("quarantine_reason")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  modelRegistry ModelRegistry @relation(fields: [modelRegistryId], references: [id], onDelete: Restrict)

  // §14.4 — what references a model version
  bookVersionsAsParser       BookVersion[]            @relation("BookVersionParserModel")
  bookVersionsAsOcr          BookVersion[]            @relation("BookVersionOcrModel")
  bookVersionsAsNormalizer   BookVersion[]            @relation("BookVersionNormalizerModel")
  parsedPagesAsOcr           ParsedPage[]             @relation("ParsedPageOcrModel")
  charactersDetected         Character[]              @relation("CharacterDetectedByModel")
  characterAliasesDetected   CharacterAlias[]         @relation("CharacterAliasDetectedByModel")
  characterRelationships     CharacterRelationship[]  @relation("CharacterRelationshipExtractedByModel")
  storyBibleVersionsBuilt    StoryBibleVersion[]      @relation("StoryBibleVersionBuiltByModel")
  sceneSemanticsExtracted    SceneSemantics[]         @relation("SceneSemanticsExtractedByModel")
  narrativeStatesExtracted   NarrativeState[]         @relation("NarrativeStateExtractedByModel")
  narrativeLocations         NarrativeLocation[]      @relation("NarrativeLocationExtractedByModel")
  narrativeTimelineEvents    NarrativeTimelineEvent[] @relation("NarrativeTimelineEventExtractedByModel")
  narrativeObjects           NarrativeObject[]        @relation("NarrativeObjectExtractedByModel")
  narrativeFactions          NarrativeFaction[]       @relation("NarrativeFactionExtractedByModel")
  narrativeThreads           NarrativeThread[]        @relation("NarrativeThreadExtractedByModel")
  narrativeSummaries         NarrativeSummary[]       @relation("NarrativeSummaryGeneratedByModel")
  narrativeEmbeddings        NarrativeEmbedding[]     @relation("NarrativeEmbeddingModel")
  voiceProfileVersionsAsTts  VoiceProfileVersion[]    @relation("VoiceProfileVersionTtsModel")
  voiceProfileVersionsAsExtractor VoiceProfileVersion[] @relation("VoiceProfileVersionEmbeddingExtractorModel")
  voicePreviewsAsTts         VoicePreview[]           @relation("VoicePreviewTtsModel")
  audioScriptsAsDirector     AudioScript[]            @relation("AudioScriptDirectorModel")
  audioScriptChunksAsDirector AudioScriptChunk[]      @relation("AudioScriptChunkDirectorModel")
  ttsJobsAsTts               TtsJob[]                 @relation("TtsJobTtsModel")
  audioChunksAsDirector      AudioChunk[]             @relation("AudioChunkDirectorModel")
  audioChunksAsTts           AudioChunk[]             @relation("AudioChunkTtsModel")
  audioChunksAsAsr           AudioChunk[]             @relation("AudioChunkAsrModel")
  chapterAudiosAsAudioTool   ChapterAudio[]           @relation("ChapterAudioAudioToolModel")
  audiobooksAsAudioTool      Audiobook[]              @relation("AudiobookAudioToolModel")
  audiobookRenditionsAsAudioTool AudiobookRendition[] @relation("AudiobookRenditionAudioToolModel")

  @@unique([modelRegistryId, version, paramsFingerprint])
  @@map("model_version")
}

// =============================================================================
// §15 — JOBS AND ATTEMPTS
// =============================================================================

/// §15.1. The sole authority on job state; the queue is a cache of this table.
model ProcessingJob {
  id       String      @id @db.Uuid
  tenantId String      @map("tenant_id") @db.Uuid
  bookId   String?     @map("book_id") @db.Uuid
  type     JobType
  queue    JobQueue
  priority JobPriority

  relatedResourceType ResourceType @map("related_resource_type")
  relatedResourceId   String       @map("related_resource_id") @db.Uuid
  scope               Json?        @db.JsonB

  /// The queue envelope this job intends to be dispatched with, written in the
  /// SAME transaction as the row itself. Dispatch is two non-transactional
  /// steps (commit the row, then enqueue), so a crash between them strands the
  /// job forever. Recovering it requires knowing the payload, and most job
  /// types' payloads are not reconstructable from this row alone
  /// (remaining_chapter_ids, story_bible_version_id, ...). Persisting the
  /// envelope here lets `ProcessingJobSweeper` re-dispatch ANY job type
  /// generically instead of re-implementing each service's payload query
  /// (QA finding F-4). Nullable: rows created before this column existed, and
  /// jobs that are never queue-dispatched, legitimately have none.
  dispatchEnvelope Json? @map("dispatch_envelope") @db.JsonB

  parentJobId        String? @map("parent_job_id") @db.Uuid
  childJobCount      Int     @default(0) @map("child_job_count")
  childSucceededCount Int    @default(0) @map("child_succeeded_count")
  childFailedCount   Int     @default(0) @map("child_failed_count")

  status          JobStatus
  statusChangedAt DateTime  @map("status_changed_at") @db.Timestamptz(6)
  blockedReason   String?   @map("blocked_reason")

  attemptCount  Int       @default(0) @map("attempt_count")
  maxAttempts   Int       @map("max_attempts")
  retryCount    Int       @default(0) @map("retry_count")
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz(6)

  progress       Float   @default(0) @db.Real
  progressStage  String? @map("progress_stage")
  completedUnits Int     @default(0) @map("completed_units")
  totalUnits     Int?    @map("total_units")

  leaseWorkerId   String?   @map("lease_worker_id") @db.Uuid
  leaseExpiresAt  DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  leaseFence      BigInt    @default(0) @map("lease_fence")

  idempotencyKey         String  @map("idempotency_key")
  idempotencyFingerprint String  @map("idempotency_fingerprint") @db.Char(64)
  forced                 Boolean @default(false)
  forcedByUserId         String? @map("forced_by_user_id") @db.Uuid

  errorCode      String?  @map("error_code")
  errorClass     String?  @map("error_class")
  errorMessage   String?  @map("error_message")
  errorRetryable Boolean? @map("error_retryable")
  errorTerminal  Boolean? @map("error_terminal")

  resultResourceType ResourceType? @map("result_resource_type")
  resultResourceId   String?       @map("result_resource_id") @db.Uuid
  resultVersion      Int?          @map("result_version")

  cancellationRequested         Boolean   @default(false) @map("cancellation_requested")
  cancellationRequestedAt       DateTime? @map("cancellation_requested_at") @db.Timestamptz(6)
  cancellationRequestedByUserId String?   @map("cancellation_requested_by_user_id") @db.Uuid
  cancellationEffectiveAt       DateTime? @map("cancellation_effective_at") @db.Timestamptz(6)

  correlationId   String  @map("correlation_id")
  causationId     String? @map("causation_id")
  traceparent     String?
  createdByUserId String? @map("created_by_user_id") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  queuedAt    DateTime? @map("queued_at") @db.Timestamptz(6)
  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  heartbeatAt DateTime? @map("heartbeat_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  book   Book?  @relation(fields: [bookId], references: [id], onDelete: Restrict)

  parentJob ProcessingJob?  @relation("ProcessingJobTree", fields: [parentJobId], references: [id], onDelete: Restrict)
  childJobs ProcessingJob[] @relation("ProcessingJobTree")

  createdByUser                 User? @relation("ProcessingJobCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  forcedByUser                  User? @relation("ProcessingJobForcedBy", fields: [forcedByUserId], references: [id], onDelete: Restrict)
  cancellationRequestedByUser   User? @relation("ProcessingJobCancellationRequestedBy", fields: [cancellationRequestedByUserId], references: [id], onDelete: Restrict)

  attempts             ProcessingAttempt[]
  dependencies         JobDependency[]      @relation("JobDependencyJob")
  dependents           JobDependency[]      @relation("JobDependencyDependsOn")
  idempotencyKeys      IdempotencyKey[]
  ttsJobs              TtsJob[]             @relation("TtsJobProcessingJob")
  characterMerges      CharacterMerge[]     @relation("CharacterMergeJob")
  storyBibleVersions   StoryBibleVersion[]  @relation("StoryBibleVersionJob")
  voicePreviews        VoicePreview[]       @relation("VoicePreviewJob")
  audioScripts         AudioScript[]        @relation("AudioScriptJob")
  chapterAudios        ChapterAudio[]       @relation("ChapterAudioJob")
  audiobooks           Audiobook[]          @relation("AudiobookJob")
  audiobookRenditions  AudiobookRendition[] @relation("AudiobookRenditionJob")

  @@index([bookId, createdAt(sort: Desc)])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([relatedResourceType, relatedResourceId])
  @@map("processing_job")
}

/// §15.2. Immutable after the terminal write. No `updated_at` (§4).
/// `worker_id` is deliberately NOT a foreign key: an attempt must outlive the
/// worker registration (§15.2).
model ProcessingAttempt {
  id                 String        @id @db.Uuid
  tenantId           String        @map("tenant_id") @db.Uuid
  jobId              String        @map("job_id") @db.Uuid
  bookId             String?       @map("book_id") @db.Uuid
  attemptNumber      Int           @map("attempt_number")
  status             AttemptStatus
  workerId           String        @map("worker_id") @db.Uuid
  workerHostRef      String?       @map("worker_host_ref")
  leaseFence         BigInt        @map("lease_fence")
  modelVersions      Json?         @map("model_versions") @db.JsonB
  startedAt          DateTime      @map("started_at") @db.Timestamptz(6)
  endedAt            DateTime?     @map("ended_at") @db.Timestamptz(6)
  durationMs         Int?          @map("duration_ms")
  errorCode          String?       @map("error_code")
  errorClass         String?       @map("error_class")
  errorMessage       String?       @map("error_message")
  errorDetail        Json?         @map("error_detail") @db.JsonB
  diagnosticStorageKey String?     @map("diagnostic_storage_key")
  resourceUsage      Json?         @map("resource_usage") @db.JsonB
  outputResourceType ResourceType? @map("output_resource_type")
  outputResourceId   String?       @map("output_resource_id") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  job    ProcessingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  book   Book?         @relation(fields: [bookId], references: [id], onDelete: Restrict)

  @@unique([jobId, attemptNumber])
  @@index([jobId, startedAt])
  @@index([workerId, startedAt(sort: Desc)])
  @@map("processing_attempt")
}

/// §15.3 join table (D-18). The DAG edges behind `BLOCKED`.
model JobDependency {
  id              String         @id @db.Uuid
  jobId           String         @map("job_id") @db.Uuid
  dependsOnJobId  String?        @map("depends_on_job_id") @db.Uuid
  kind            DependencyKind
  gateKey         String?        @map("gate_key")
  satisfiedAt     DateTime?      @map("satisfied_at") @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  job          ProcessingJob  @relation("JobDependencyJob", fields: [jobId], references: [id], onDelete: Cascade)
  dependsOnJob ProcessingJob? @relation("JobDependencyDependsOn", fields: [dependsOnJobId], references: [id], onDelete: Cascade)

  // The document specifies `UNIQUE (job_id, depends_on_job_id, gate_key) NULLS NOT DISTINCT`
  // (PostgreSQL 15+). Prisma cannot emit NULLS NOT DISTINCT, so it lives in migration.sql.
  @@map("job_dependency")
}

/// §15.4. The HTTP-layer idempotency registry, distinct from job identity (§21.2).
model IdempotencyKey {
  id                 String            @id @db.Uuid
  tenantId           String            @map("tenant_id") @db.Uuid
  principalId        String            @map("principal_id") @db.Uuid
  method             String
  pathTemplate       String            @map("path_template")
  key                String
  requestBodyHash    String            @map("request_body_hash") @db.Char(64)
  status             IdempotencyStatus
  responseStatusCode Int?              @map("response_status_code")
  responseBody       Json?             @map("response_body") @db.JsonB
  responseLocation   String?           @map("response_location")
  jobId              String?           @map("job_id") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt        DateTime?         @map("completed_at") @db.Timestamptz(6)
  expiresAt          DateTime          @map("expires_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  job    ProcessingJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@unique([tenantId, principalId, method, pathTemplate, key])
  @@index([expiresAt])
  @@index([jobId])
  @@map("idempotency_key")
}

/// §15.5. Not tenant-scoped — workers are cross-tenant by necessity. Never
/// exposed publicly. `created_at` is added per the §4 universal timestamp rule.
model Worker {
  id                    String       @id @db.Uuid
  kind                  WorkerKind
  queues                JobQueue[]
  capabilities          Json         @db.JsonB
  loadedModelVersionIds String[]     @map("loaded_model_version_ids") @db.Uuid
  status                WorkerStatus
  quarantineReason      String?      @map("quarantine_reason")
  quarantinedAt         DateTime?    @map("quarantined_at") @db.Timestamptz(6)
  lastHeartbeatAt       DateTime?    @map("last_heartbeat_at") @db.Timestamptz(6)
  serviceVersion        String       @map("service_version")
  firstSeenAt           DateTime     @map("first_seen_at") @db.Timestamptz(6)
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, lastHeartbeatAt])
  @@map("worker")
}

// =============================================================================
// §17 — AUDIT LOG
// =============================================================================

/// §17.1. Append-only; no application role holds UPDATE or DELETE (§37.3).
/// PARTITIONED BY RANGE (occurred_at) — Prisma has no partition support, so the
/// partitioning (and the PK widening it forces) is applied in migration.sql.
/// `resource_id` deliberately carries NO foreign key: the log is polymorphic and
/// must survive the purge of its target.
model AuditLog {
  id            String       @id @db.Uuid
  seq           BigInt       @default(autoincrement())
  occurredAt    DateTime     @map("occurred_at") @db.Timestamptz(6)
  tenantId      String?      @map("tenant_id") @db.Uuid
  actorKind     ActorKind    @map("actor_kind")
  actorUserId   String?      @map("actor_user_id") @db.Uuid
  actorService  String?      @map("actor_service")
  action        AuditAction
  resourceType  ResourceType @map("resource_type")
  resourceId    String?      @map("resource_id") @db.Uuid
  bookId        String?      @map("book_id") @db.Uuid
  requestId     String?      @map("request_id")
  traceId       String?      @map("trace_id")
  correlationId String?      @map("correlation_id")
  outcome       AuditOutcome
  metadata      Json?        @db.JsonB
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actorUser User?   @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([resourceType, resourceId, occurredAt(sort: Desc)])
  @@index([actorUserId, occurredAt(sort: Desc)])
  @@map("audit_log")
}

// =============================================================================
// §15.6 / §15.7 — OUTBOX AND INBOX (closes E-19 / OQ-EV-1)
// =============================================================================

/// §15.6. The write side of the Outbox pattern: a domain state change and the
/// intent to publish it are written in the same transaction. The document's
/// column list ends at `created_at`; no `updated_at` is specified.
model OutboxMessage {
  id              String       @id @db.Uuid
  eventId         String       @unique @map("event_id") @db.Uuid
  eventType       String       @map("event_type")
  schemaVersion   String       @map("schema_version")
  occurredAt      DateTime     @map("occurred_at") @db.Timestamptz(6)
  tenantId        String       @map("tenant_id") @db.Uuid
  bookId          String?      @map("book_id") @db.Uuid
  jobId           String?      @map("job_id") @db.Uuid
  correlationId   String       @map("correlation_id")
  causationId     String       @map("causation_id")
  traceparent     String?
  producer        String
  producerVersion String       @map("producer_version")
  payload         Json         @db.JsonB
  aggregateType   String       @map("aggregate_type")
  aggregateId     String       @map("aggregate_id") @db.Uuid
  status          OutboxStatus @default(PENDING)
  publishedAt     DateTime?    @map("published_at") @db.Timestamptz(6)
  publishAttempts Int          @default(0) @map("publish_attempts")
  lastError       String?      @map("last_error")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  book   Book?  @relation(fields: [bookId], references: [id], onDelete: Restrict)

  @@index([aggregateType, aggregateId, createdAt])
  @@map("outbox_message")
}

/// §15.7. The read side: "have I already processed this fact?" under
/// at-least-once delivery. A primary-key violation means "already processed" and
/// is success, not an error.
model EventInbox {
  consumerName String       @map("consumer_name")
  eventId      String       @map("event_id") @db.Uuid
  processedAt  DateTime     @map("processed_at") @db.Timestamptz(6)
  outcome      InboxOutcome
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([consumerName, eventId])
  @@index([processedAt])
  @@map("event_inbox")
}
