// =============================================================================
// Audiobook Production Platform — Prisma schema
//
// DERIVED FROM: docs/architecture/database-schema.md (`db-schema.v1.1`).
// That document is the persistence contract of record. This file is derived
// from it and is NEVER the reverse (database-schema.md §36, §45 rule 2).
//
// Everything Prisma cannot express — partial unique indexes, CHECK constraints,
// the `character_alias` exclusion constraint, GENERATED ALWAYS ... STORED
// columns, `audit_log` partitioning, `citext`, and the pgvector column type —
// lives in prisma/migrations/0001_init/migration.sql and is asserted by the
// mandatory drift test (§36, §41.3 check 12). See prisma/README.md.
//
// ID generation is APPLICATION-SIDE UUIDv7 (§3.1, §36 "UUID generation").
// No `@default(uuid())` and no `@default(dbgenerated(...))` appears anywhere.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS — database-schema.md §24 ("Enum inventory"). Members are verbatim from
// the upstream contract. Where the upstream vocabulary is lowercase (`job_type`,
// `job_queue`, `resource_type`) it is preserved lowercase: §4 requires members
// "verbatim from the upstream contract" and §24 prints them that way.
// =============================================================================

