  // Embedded metadata, snapshotted at assembly
  metadataTitle           String  @map("metadata_title")
  metadataAuthor          String? @map("metadata_author")
  metadataNarratorCredit  String? @map("metadata_narrator_credit")
  aiNarrationDisclosed    Boolean @default(true) @map("ai_narration_disclosed")
  metadataSeries          String? @map("metadata_series")
  metadataSeriesIndex     Int?    @map("metadata_series_index")
  metadataPublisher       String? @map("metadata_publisher")
  metadataLanguage        String  @map("metadata_language")
  metadataPublicationYear Int?    @map("metadata_publication_year")
  metadataDescription     String? @map("metadata_description")

  audiobookCoverId String? @map("audiobook_cover_id") @db.Uuid

  bookWer       Float? @map("book_wer") @db.Real
  chunksFlagged Int    @default(0) @map("chunks_flagged")
  asrCoverage   Float? @map("asr_coverage") @db.Real

  pipelineVersion         String   @map("pipeline_version")
  directorVersion         String   @map("director_version")
  ttsModelVersionIds      String[] @map("tts_model_version_ids") @db.Uuid
  audioToolModelVersionId String   @map("audio_tool_model_version_id") @db.Uuid
  sourceContentHash       String   @map("source_content_hash") @db.Char(64)
  storyBibleVersionId     String   @map("story_bible_version_id") @db.Uuid
  chapterManifestHash     String   @map("chapter_manifest_hash") @db.Char(64)

  jobId String? @map("job_id") @db.Uuid

  // §4.4 storage reference group (primary container)
  storageKey       String       @map("storage_key")
  storageBucket    String       @map("storage_bucket")
  contentHash      String       @map("content_hash") @db.Char(64)
  sizeBytes        BigInt?      @map("size_bytes")
  objectVerifiedAt DateTime?    @map("object_verified_at") @db.Timestamptz(6)
  storageClass     StorageClass @default(STANDARD) @map("storage_class")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  book                  Book              @relation("BookAudiobooks", fields: [bookId, tenantId], references: [id, tenantId], onDelete: Restrict)
  bookVersion           BookVersion       @relation(fields: [bookVersionId], references: [id], onDelete: Restrict)
  storyBibleVersion     StoryBibleVersion @relation(fields: [storyBibleVersionId], references: [id], onDelete: Restrict)
  audioToolModelVersion ModelVersion      @relation("AudiobookAudioToolModel", fields: [audioToolModelVersionId], references: [id], onDelete: Restrict)
  job                   ProcessingJob?    @relation("AudiobookJob", fields: [jobId], references: [id], onDelete: SetNull)
  cover                 AudiobookCover?   @relation("AudiobookSelectedCover", fields: [audiobookCoverId], references: [id], onDelete: SetNull)

  supersedesAudiobook   Audiobook?  @relation("AudiobookSupersedes", fields: [supersedesAudiobookId], references: [id], onDelete: Restrict)
  supersededAudiobooks  Audiobook[] @relation("AudiobookSupersedes")
  supersededByAudiobook Audiobook?  @relation("AudiobookSupersededBy", fields: [supersededByAudiobookId], references: [id], onDelete: Restrict)
  supersedingAudiobooks Audiobook[] @relation("AudiobookSupersededBy")

  currentForBooks   Book[]               @relation("BookCurrentAudiobook")
  chapters          AudiobookChapter[]
  renditions        AudiobookRendition[]
  covers            AudiobookCover[]     @relation("AudiobookCovers")

  @@unique([bookId, version])
  @@index([bookId, createdAt(sort: Desc)])
  @@index([bookVersionId])
  @@map("audiobook")
}

/// §16.6 join table (D-18). The ordered chapter manifest with markers.
model AudiobookChapter {
  audiobookId    String   @map("audiobook_id") @db.Uuid
  orderIndex     Int      @map("order_index")
  chapterId      String   @map("chapter_id") @db.Uuid
  chapterAudioId String   @map("chapter_audio_id") @db.Uuid
  bookId         String   @map("book_id") @db.Uuid
  title          String?
  startMs        Int      @map("start_ms")
  durationMs     Int      @map("duration_ms")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  audiobook    Audiobook    @relation(fields: [audiobookId], references: [id], onDelete: Cascade)
  chapter      Chapter      @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  chapterAudio ChapterAudio @relation(fields: [chapterAudioId], references: [id], onDelete: Restrict)
  book         Book         @relation(fields: [bookId], references: [id], onDelete: Restrict)

  @@id([audiobookId, orderIndex])
  @@unique([audiobookId, chapterId])
  @@index([chapterAudioId])
  @@map("audiobook_chapter")
}

/// §16.7. One encoded delivery artifact. `MP3_PER_CHAPTER` is n objects, which a
/// single `storage_key` on `audiobook` cannot express.
model AudiobookRendition {
  id                      String         @id @db.Uuid
  tenantId                String         @map("tenant_id") @db.Uuid
  bookId                  String         @map("book_id") @db.Uuid
  audiobookId             String         @map("audiobook_id") @db.Uuid
  format                  DeliveryFormat
  chapterId               String?        @map("chapter_id") @db.Uuid
  bitrateKbps             Int            @map("bitrate_kbps")
  sampleRate              Int            @map("sample_rate")
  channels                Int
  durationMs              Int            @map("duration_ms")
  audioToolModelVersionId String         @map("audio_tool_model_version_id") @db.Uuid
  encodeParams            Json?          @map("encode_params") @db.JsonB
  /// §16.7 lists a `status` column but names no enum type for it, and §24 has no
  /// entry. Stored as text pending resolution — see prisma/README.md.
  status                  String
  jobId                   String?        @map("job_id") @db.Uuid

  // §4.4 storage reference group
  storageKey       String       @map("storage_key")
  storageBucket    String       @map("storage_bucket")
  contentHash      String       @map("content_hash") @db.Char(64)
  sizeBytes        BigInt?      @map("size_bytes")
  objectVerifiedAt DateTime?    @map("object_verified_at") @db.Timestamptz(6)
  storageClass     StorageClass @default(STANDARD) @map("storage_class")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  book                  Book           @relation(fields: [bookId, tenantId], references: [id, tenantId], onDelete: Restrict)
  audiobook             Audiobook      @relation(fields: [audiobookId], references: [id], onDelete: Cascade)
  chapter               Chapter?       @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  audioToolModelVersion ModelVersion   @relation("AudiobookRenditionAudioToolModel", fields: [audioToolModelVersionId], references: [id], onDelete: Restrict)
  job                   ProcessingJob? @relation("AudiobookRenditionJob", fields: [jobId], references: [id], onDelete: SetNull)

  @@index([audiobookId])
  @@map("audiobook_rendition")
}

/// §16.8. Separate from `audiobook` because a cover is an uploaded binary with
/// its own validation lifecycle (allowlist, dimension bounds, EXIF stripping).
model AudiobookCover {
  id               String    @id @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  bookId           String    @map("book_id") @db.Uuid
  audiobookId      String    @map("audiobook_id") @db.Uuid
  width            Int
  height           Int
  mimeType         String    @map("mime_type")
  exifStrippedAt   DateTime? @map("exif_stripped_at") @db.Timestamptz(6)
  uploadedByUserId String    @map("uploaded_by_user_id") @db.Uuid

  // §4.4 storage reference group
  storageKey       String        @map("storage_key")
  storageBucket    String        @map("storage_bucket")
  contentHash      String        @map("content_hash") @db.Char(64)
  contentHashAlgorithm HashAlgorithm @map("content_hash_algorithm")
  sizeBytes        BigInt?       @map("size_bytes")
  objectVerifiedAt DateTime?     @map("object_verified_at") @db.Timestamptz(6)
  storageClass     StorageClass  @default(STANDARD) @map("storage_class")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  book           Book      @relation(fields: [bookId, tenantId], references: [id, tenantId], onDelete: Restrict)
  audiobook      Audiobook @relation("AudiobookCovers", fields: [audiobookId], references: [id], onDelete: Cascade)
  uploadedByUser User      @relation("AudiobookCoverUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  selectedByAudiobooks Audiobook[] @relation("AudiobookSelectedCover")

  @@map("audiobook_cover")
}

