{
  "name": "@audio-book/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./analysis/analysis.service": "./dist/analysis/analysis.service.js",
    "./assembly/assembly.service": "./dist/assembly/assembly.service.js",
    "./books/books.service": "./dist/books/books.service.js",
    "./common/pipes/ajv-validation.pipe": "./dist/common/pipes/ajv-validation.pipe.js",
    "./common/rate-limit/rate-limiter": "./dist/common/rate-limit/rate-limiter.js",
    "./director/director.service": "./dist/director/director.service.js",
    "./tts/tts.service": "./dist/tts/tts.service.js",
    "./voice/voice.service": "./dist/voice/voice.service.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start:dev": "tsc -p tsconfig.json && node --watch dist/main.js",
    "start": "node dist/main.js",
    "test": "vitest run",
    "build:watch": "tsc -p tsconfig.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@audio-book/config": "workspace:*",
    "@audio-book/contracts": "workspace:*",
    "@audio-book/database": "workspace:*",
    "@audio-book/errors": "workspace:*",
    "@audio-book/events": "workspace:*",
    "@audio-book/ingestion": "workspace:*",
    "@audio-book/logging": "workspace:*",
    "@audio-book/observability": "workspace:*",
    "@audio-book/queue": "workspace:*",
    "@audio-book/storage": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-fastify": "^10.4.15",
    "@node-rs/argon2": "^2.2.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fastify": "^4.29.0",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
