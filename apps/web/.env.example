# Audiobook Studio (apps/web) — local development.
#
# Copy to `.env.local`, or set these in the repository-root `.env` that Docker
# Compose reads. Every variable here is SERVER-side: none is `NEXT_PUBLIC_`,
# so none is inlined into the browser bundle. The browser talks only to this
# app's own same-origin `/bff` mount and never learns the API's address.

# Internal address of the Phase 8 application API.
AUDIOBOOK_API_URL=http://localhost:3000

# Public origin of this app. Used for the strict same-origin check on writes.
WEB_PUBLIC_ORIGIN=http://localhost:3001

# `Secure` on the session cookie, and the `__Host-` cookie prefix with it.
# Set to `false` ONLY for plain-HTTP local development.
SESSION_COOKIE_SECURE=false

# Token verification. These MUST match the API's own AUTH_JWT_* configuration:
# the studio verifies the identity provider's token the same way the API does,
# and issues nothing itself. Provide either the JWKS URL or the public key.
AUTH_JWT_ISSUER=https://auth.local
AUTH_JWT_AUDIENCE=audiobook-api
AUTH_JWT_JWKS_URL=
AUTH_JWT_PUBLIC_KEY=
