{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 1,
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 500 },
    "author": { "type": "string", "minLength": 1, "maxLength": 500 },
    "narrator_credit": { "type": "string", "minLength": 1, "maxLength": 500 },
    "series": { "type": "string", "minLength": 1, "maxLength": 500 },
    "series_index": { "type": "number", "minimum": 0 },
    "publisher": { "type": "string", "minLength": 1, "maxLength": 500 },
    "language": { "type": "string", "minLength": 2, "maxLength": 35 },
    "publication_year": { "type": "integer", "minimum": 1000, "maximum": 9999 },
    "description": { "type": "string", "maxLength": 5000 }
  }
}
