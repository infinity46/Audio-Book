{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["book_file_id"],
  "properties": {
    "book_file_id": { "type": "string", "format": "uuid" },
    "force": { "type": "boolean" },
    "priority": { "type": "string", "enum": ["INTERACTIVE", "NORMAL", "BULK"] }
  }
}
