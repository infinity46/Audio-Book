{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "language"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 512 },
    "author": { "type": "string", "minLength": 1, "maxLength": 512 },
    "language": { "type": "string", "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})*$" },
    "description": { "type": "string", "maxLength": 8192 },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "series": { "type": "string", "maxLength": 512 },
        "series_index": { "type": "integer", "minimum": 0 },
        "publication_year": { "type": "integer", "minimum": 0 },
        "publisher": { "type": "string", "maxLength": 512 }
      }
    }
  }
}
