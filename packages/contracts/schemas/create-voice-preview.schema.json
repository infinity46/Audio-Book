{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["samples"],
  "properties": {
    "book_id": { "type": "string", "format": "uuid" },
    "character_id": { "type": "string", "format": "uuid" },
    "priority": { "type": "string", "enum": ["INTERACTIVE", "NORMAL", "BULK"] },
    "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text_excerpt", "emotion"],
        "properties": {
          "text_excerpt": { "type": "string", "minLength": 1, "maxLength": 500 },
          "emotion": {
            "type": "string",
            "enum": [
              "NEUTRAL",
              "HAPPY",
              "SAD",
              "GRIEF",
              "ANGRY",
              "FEARFUL",
              "SURPRISED",
              "DISGUSTED",
              "EXCITED",
              "CALM",
              "TENSE",
              "ANXIOUS",
              "SOMBER",
              "CONFIDENT",
              "UNCERTAIN",
              "PLAYFUL",
              "SERIOUS"
            ]
          }
        }
      }
    }
  }
}
