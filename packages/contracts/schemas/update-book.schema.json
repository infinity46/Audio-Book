{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UpdateBook",
  "description": "PATCH /api/v1/books/{bookId} — api-specification.md §16.5. User-editable metadata only; `status` is deliberately absent because pipeline state is never patchable.",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 1,
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 512 },
    "author": { "type": ["string", "null"], "maxLength": 512 },
    "language": { "type": "string", "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})*$" },
    "description": { "type": ["string", "null"], "maxLength": 8192 },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "series": { "type": ["string", "null"], "maxLength": 512 },
        "series_index": { "type": ["integer", "null"], "minimum": 0 },
        "publication_year": { "type": ["integer", "null"], "minimum": 0 },
        "publisher": { "type": ["string", "null"], "maxLength": 512 }
      }
    }
  }
}
