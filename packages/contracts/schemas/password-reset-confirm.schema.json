{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PasswordResetConfirm",
  "description": "POST /api/v1/auth/password-reset/confirm — api-specification.md §16.1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["reset_token", "new_password"],
  "properties": {
    "reset_token": { "type": "string", "minLength": 1, "maxLength": 512 },
    "new_password": { "type": "string", "minLength": 1, "maxLength": 256 }
  }
}
