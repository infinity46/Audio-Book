{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tts_provider_id",
    "tts_model_id",
    "tts_model_version_id",
    "language",
    "reference_audio_consent"
  ],
  "properties": {
    "tts_provider_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "tts_model_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "tts_model_version_id": { "type": "string", "format": "uuid" },
    "language": { "type": "string", "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})*$" },
    "supported_languages": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})*$" },
      "minItems": 1,
      "maxItems": 32
    },
    "base_generation_params": { "type": "object" },
    "default_pitch": { "type": "number", "minimum": -1.0, "maximum": 1.0 },
    "default_volume": { "type": "number", "minimum": -1.0, "maximum": 1.0 },
    "default_pacing": { "type": "number", "minimum": 0.5, "maximum": 2.0 },
    "derive_from_version": { "type": "integer", "minimum": 1 },
    "reference_audio_consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attested", "subject"],
      "properties": {
        "attested": { "type": "boolean" },
        "subject": { "type": "string", "enum": ["SYNTHETIC", "SELF", "THIRD_PARTY_CONSENTED"] },
        "attestation_text": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    }
  }
}
